<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShopifyMcp.Server</RootNamespace>
    <AssemblyName>shopify-mcp</AssemblyName>

    <!-- Packaged as a .NET tool so it can be installed with `dotnet tool install -g` or run with `dnx`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>shopify-mcp</ToolCommandName>
    <PackageId>ShopifyMcp.Server</PackageId>
    <PackageType>McpServer</PackageType>
    <Description>MCP server that lets AI assistants (Claude Code, Claude Desktop, Cursor) read and manage a Shopify store.</Description>
    <PackageTags>shopify;mcp;model-context-protocol;ai;claude</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShopifyMcp.Infrastructure\ShopifyMcp.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
